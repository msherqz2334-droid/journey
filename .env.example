# Copy to .env and replace SESSION_SECRET with at least 32 random characters.
SESSION_SECRET=replace_this_with_a_long_random_secret_before_starting
PORT=3000
NODE_ENV=development
DB_FILE=./data/travel.sqlite
SESSION_DIR=./data/sessions
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
CANCELLATION_FEE_CENTS=2500

# Social sign-in (leave blank to disable each provider)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# AI travel assistant
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=allam-2-7b
